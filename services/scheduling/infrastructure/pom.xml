<?xml version="1.0" encoding="UTF-8"?>
<!--
  Der Rand: Spring Boot, REST, Persistenz. Das einzige Modul, das ein
  Framework kennt, und das einzige, das man starten kann.

  ArchUnit liegt hier, weil hier alle drei Module auf dem Klassenpfad sind
  und die Abhaengigkeitsrichtung ueber Modulgrenzen nur hier pruefbar ist.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.aptum</groupId>
    <artifactId>scheduling</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>scheduling-infrastructure</artifactId>
  <name>Aptum Scheduling Infrastructure</name>

  <dependencies>
    <dependency>
      <groupId>de.aptum</groupId>
      <artifactId>scheduling-application</artifactId>
    </dependency>
    <dependency>
      <groupId>de.aptum</groupId>
      <artifactId>scheduling-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
