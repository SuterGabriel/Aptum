<?xml version="1.0" encoding="UTF-8"?>
<!--
  Der Rand: Spring Boot, REST, Persistenz. Das einzige Modul, das ein
  Framework kennt, und das einzige, das man starten kann.

  ArchUnit liegt hier, weil hier alle drei Module auf dem Klassenpfad sind
  und die Abhaengigkeitsrichtung ueber Modulgrenzen nur hier pruefbar ist.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.aptum</groupId>
    <artifactId>scheduling</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>scheduling-infrastructure</artifactId>
  <name>Aptum Scheduling Infrastructure</name>

  <dependencies>
    <dependency>
      <groupId>de.aptum</groupId>
      <artifactId>scheduling-application</artifactId>
    </dependency>
    <dependency>
      <groupId>de.aptum</groupId>
      <artifactId>scheduling-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!--
      OpenAPI aus den Controllern, nicht von Hand. Das erzeugte Dokument liegt
      unter docs/api/openapi.json im Repo; ein Test vergleicht es mit dem, was
      die laufende Anwendung liefert. Sonst waere es die naechste Datei, die
      still veraltet.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.1.1</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers: ein echtes Postgres je Testklasse. Row Level Security
      laesst sich nicht gegen H2 pruefen, und ein Isolationstest gegen eine
      andere Datenbank als die produktive waere eine Behauptung.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Docker 29 verlangt mindestens API 1.40; docker-java handelt ohne
        Vorgabe eine aeltere aus, und der Daemon antwortet mit 400 - was
        Testcontainers als "kein Docker gefunden" meldet. Die Eigenschaft
        muss in die geforkte Test-JVM, nicht in die von Maven; eine
        Umgebungsvariable liest docker-java dafuer nicht. Aeltere Daemons
        koennen 1.44 ebenfalls, der Wert ist also nach unten vertraeglich.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- @{argLine} ist der JaCoCo-Agent aus dem Root-POM; ohne den Platzhalter
               verdrängt die Docker-Option ihn, und das Modul hat keine Abdeckung. -->
          <argLine>@{argLine} -Dapi.version=1.44</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
