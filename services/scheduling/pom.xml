<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent des Service "scheduling". Grundlage: ADR-008 (Maven statt Gradle).

  Es gibt vorerst genau ein Modul. `application` und `infrastructure` folgen,
  wenn sie Inhalt haben - ein leeres Modul ist dasselbe wie ein CI-Job, der
  nichts prueft und trotzdem gruen meldet.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.aptum</groupId>
  <artifactId>scheduling</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Aptum Scheduling</name>

  <!--
    Drei Module nach ADR-001 und ADR-008. Die Abhaengigkeit zeigt nur nach
    innen: infrastructure kennt application und domain, application kennt
    domain, domain kennt nichts. ArchUnit prueft das in infrastructure, wo
    alle drei auf dem Klassenpfad liegen.
  -->
  <modules>
    <module>domain</module>
    <module>application</module>
    <module>infrastructure</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <archunit.version>1.3.0</archunit.version>
    <spring-boot.version>3.5.3</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Spring Boot als BOM, nicht als Parent. Der Parent bleibt unserer, damit
        die Module ohne Spring - domain und application - nichts davon erben.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>de.aptum</groupId>
        <artifactId>scheduling-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.aptum</groupId>
        <artifactId>scheduling-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <!-- Parameternamen in den Klassen behalten. Spring liest daraus den
               Namen eines @RequestParam; ohne dieses Flag heißt er arg0, und
               ?tag=... wird nie gebunden. Der Boot-Parent setzt es still, das
               BOM (ADR-008) nicht - deshalb steht es hier ausdrücklich. -->
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        "Formatiert" ist die erste Bedingung in CLAUDE.md unter "Was jede
        Aenderung erfuellen muss". Ohne Werkzeug war das eine Behauptung.
        `mvn spotless:apply` formatiert, `mvn spotless:check` prueft - in der
        CI und im Hook, sobald Java-Dateien vorgemerkt sind.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.44.3</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>2.50.0</version>
            </palantirJavaFormat>
            <removeUnusedImports />
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
